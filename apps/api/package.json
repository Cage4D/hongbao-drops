{
  "name": "@hongbao/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.test.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@hongbao/contract": "workspace:*",
    "@hongbao/shared": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cashscript": "0.14.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "^1.16.22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
