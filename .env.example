# Copy to .env and fill in. NEVER commit .env or log these values.

# --- Network -----------------------------------------------------------------
# CHIPNET (default) or MAINNET. Mainnet only from Phase 8 / day 6 (spec §10.1).
NETWORK=CHIPNET
# Comma-separated Fulcrum WSS endpoints, tried in order (see docs/findings.md §6).
FULCRUM_URLS=wss://chipnet.bch.ninja:50004,wss://chipnet.imaginary.cash:50004

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://hongbao:hongbao@localhost:5432/hongbao

# --- Secrets -----------------------------------------------------------------
# Hex-encoded 32+ byte seed for per-envelope gate keys (spec §8.3).
GATE_MASTER_SEED=
# Bearer token for /admin/* endpoints.
ADMIN_TOKEN=

# --- Business ----------------------------------------------------------------
TREASURY_ADDRESS=
SPONSOR_FEE_BPS=300
ENABLE_STAMPS=true

# --- URLs --------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:3000
PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin-cash&vs_currencies=usd

# --- Budget caps (spec §10.1) — enforced on MAINNET only -----------------------
MAX_ENVELOPE_USD=0.50
MAX_ENVELOPE_SATS=200000
MAX_SHARES=10
MAX_ACTIVE_MAINNET_SATS=600000
DAILY_MAINNET_SATS=400000
MIN_EXPIRY_SECONDS=600
BUDGET_TOTAL_USD=5.00
