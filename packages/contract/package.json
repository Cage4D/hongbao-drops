{
  "name": "@hongbao/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "cashc contracts/Hongbao.cash -f ts -o src/artifacts/Hongbao.ts && cashc contracts/Hongbao.cash -o src/artifacts/Hongbao.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "cashscript": "0.14.0"
  },
  "devDependencies": {
    "cashc": "0.14.0"
  },
  "files": [
    "dist",
    "contracts",
    "src/artifacts"
  ]
}
